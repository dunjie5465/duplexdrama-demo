_id": "role_2", "speaker_name": "张明", "role_label": "HM", "text_complete": "<注释>松口气</注释>七八个人倒是还行，一桌就能坐下，也不至于把你累得腰酸背痛的。", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 87.9492, "end_time": 94.339}, {"turn_id": 11, "speaker": "AI", "text": "<user_backchannel>就是嘛，一桌的事儿。</user_backchannel>", "emotion": "附和", "tts_prompt": "六十多岁女性声音，低声附和，音量较小，语调轻快。", "speech_rate": "Medium", "pause_after": "Short (0.31s)", "tts_tag": "[whispering]", "tts_tag_score": 5, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "interruption_type": "附和", "reason": "舞台指示含附和；附和与求答已拆轮。", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 91.6292, "end_time": 93.7094}, {"turn_id": 12, "speaker": "AI", "text": "快跟我过来，瞧瞧我刚收拾妥当的南向大阳台。", "emotion": "兴奋", "tts_prompt": "六十多岁女性声音，语气兴奋，带着分享的喜悦。", "speech_rate": "Medium", "pause_after": "Short (0.21s)", "tts_tag": "[happy]", "tts_tag_score": 8, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [{"request_id": "turn_12:0", "sound_kind": "event", "applies_to": ["AI", "HM"], "intensity": "medium", "note": "AI起身挪动椅子准备带HM去阳台", "macro_class": "human_movement", "event_class": "chair_sit_stand", "position_hint": "pre_utterance", "repetition": "single", "confidence": 0.85}, {"request_id": "turn_12:1", "sound_kind": "event", "applies_to": ["AI", "HM"], "intensity": "medium", "note": "AI向阳台走去", "macro_class": "human_movement", "event_class": "footstep_indoor", "position_hint": "flexible", "repetition": "single", "confidence": 0.85}], "turn_event_requests": [{"request_id": "turn_12:0", "sound_kind": "event", "macro_class": "human_movement", "event_class": "chair_sit_stand", "applies_to": ["AI", "HM"], "position_hint": "pre_utterance", "intensity": "medium", "repetition": "single", "confidence": 0.85, "note": "AI起身挪动椅子准备带HM去阳台"}, {"request_id": "turn_12:1", "sound_kind": "event", "macro_class": "human_movement", "event_class": "footstep_indoor", "applies_to": ["AI", "HM"], "position_hint": "flexible", "intensity": "medium", "repetition": "single", "confidence": 0.85, "note": "AI向阳台走去"}], "start_time": 94.639, "end_time": 99.6927}, {"turn_id": 13, "speaker": "HM", "text": "哎你走慢点儿。我倒要好好瞅瞅你这宝贝阳台整成啥样了。", "emotion": "好奇", "tts_prompt": "年轻男性声音，语气好奇，略带调侃。", "speech_rate": "Medium", "pause_after": "Short (0.29s)", "tts_tag": "[happy]", "tts_tag_score": 6, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [{"request_id": "turn_13:0", "sound_kind": "event", "applies_to": ["AI", "HM"], "intensity": "medium", "note": "HM起身跟上", "macro_class": "human_movement", "event_class": "chair_sit_stand", "position_hint": "pre_utterance", "repetition": "single", "confidence": 0.85}, {"request_id": "turn_13:1", "sound_kind": "event", "applies_to": ["AI", "HM"], "intensity": "medium", "note": "HM跟随走向阳台", "macro_class": "human_movement", "event_class": "footstep_indoor", "position_hint": "flexible", "repetition": "single", "confidence": 0.85}], "turn_event_requests": [{"request_id": "turn_13:0", "sound_kind": "event", "macro_class": "human_movement", "event_class": "chair_sit_stand", "applies_to": ["AI", "HM"], "position_hint": "pre_utterance", "intensity": "medium", "repetition": "single", "confidence": 0.85, "note": "HM起身跟上"}, {"request_id": "turn_13:1", "sound_kind": "event", "macro_class": "human_movement", "event_class": "footstep_indoor", "applies_to": ["AI", "HM"], "position_hint": "flexible", "intensity": "medium", "repetition": "single", "confidence": 0.85, "note": "HM跟随走向阳台"}], "start_time": 99.9026, "end_time": 106.3452}, {"turn_id": 14, "speaker": "AI", "text": "<注释>骄傲</注释>你看这朝南的大阳台，我刚把那些花花草草都归置好了，你瞅着是不是都水灵灵的特精神？", "emotion": "骄傲", "tts_prompt": "六十多岁女性声音，语气骄傲，带着展示的喜悦。", "speech_rate": "Medium", "pause_after": "Short (0.21s)", "tts_tag": "[happy]", "tts_tag_score": 8, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 106.6352, "end_time": 114.7836}, {"turn_id": 15, "speaker": "HM", "text": "<注释>赞叹</注释>嚯，你这动作也太快了！两边摆两大盆龟背竹，中间是月季，那边还码了一排多肉，这不就是个迷你小花园嘛！", "emotion": "赞叹", "tts_prompt": "年轻男性声音，语气赞叹，充满惊喜。", "speech_rate": "Medium", "pause_after": "Short (0.31s)", "tts_tag": "[surprised]", "tts_tag_score": 8, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 114.9936, "end_time": 125.032}, {"turn_id": 16, "speaker": "AI", "text": "那可不，角落我还放了把小藤椅，平时坐这儿晒晒太阳喝喝茶，多舒服啊。", "emotion": "得意", "tts_prompt": "六十多岁女性声音，语气得意，带着满足。", "speech_rate": "Medium", "pause_after": "Short (0.33s)", "tts_tag": "[happy]", "tts_tag_score": 7, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 125.342, "end_time": 132.6509}, {"turn_id": 17, "speaker": "HM", "text": "妈你眼光真的好，这布置得太有那味儿了。当初选这套带南向大阳台的房子，真的是买对了，太值了。", "emotion": "赞赏", "tts_prompt": "年轻男性声音，语气赞赏，真诚。", "speech_rate": "Medium", "pause_after": "Short (0.29s)", "tts_tag": "[happy]", "tts_tag_score": 7, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 132.9809, "end_time": 143.4727}, {"turn_id": 18, "speaker": "AI", "text": "<注释>感慨</注释>那可不值当嘛。你摸摸这龟背竹的叶子，油亮油亮的长得多好，瞅着它们我就想起以前那老破小的公房。", "emotion": "感慨", "tts_prompt": "六十多岁女性声音，语气感慨，带着怀旧的情绪。", "speech_rate": "Medium", "pause_after": "Short (0.26s)", "tts_tag": "[sad]", "tts_tag_score": 4, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 143.7627, "end_time": 152.9024}, {"turn_id": 19, "speaker": "HM", "text": "以前那老房子真的憋屈，连个正经独立阳台都没有，我记得你那时候养花，只能挤在窄窗台上，转个身都费劲。", "emotion": "回忆", "tts_prompt": "年轻男性声音，语气回忆，带着一丝心酸。", "speech_rate": "Medium", "pause_after": "Short (0.21s)", "tts_tag": "[sad]", "tts_tag_score": 6, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 153.1624, "end_time": 163.3121}, {"turn_id": 20, "speaker": "AI", "text": "<注释>叹气</注释>可不是嘛，那时候窗台上也就搁得下几盆葱，再加一盆绿萝，多一盆都放不下。", "emotion": "无奈", "tts_prompt": "六十多岁女性声音，语气无奈，叹气，带着对过去的感慨。", "speech_rate": "Medium", "pause_after": "Short (0.22s)", "tts_tag": "[sad]", "tts_tag_score": 6, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 163.5221, "end_time": 170.5117}, {"turn_id": 21, "speaker": "HM", "text": "<注释>心酸</注释>我现在想起来都觉得心里发酸。你那么爱养花，硬生生委屈了那么多年，现在终于圆了花园梦，我真的特高兴。", "emotion": "心酸", "tts_prompt": "年轻男性声音，语气心酸，带着心疼和欣慰。", "speech_rate": "Medium", "pause_after": "Short (0.24s)", "tts_tag": "[sad]", "tts_tag_score": 7, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 170.7317, "end_time": 179.999}, {"turn_id": 22, "speaker": "AI", "text": "<注释>温和</注释>傻孩子，妈有啥可委屈的？现在能住上你给我买的这么好的房子，我这心里啊，早就甜得冒泡泡了。", "emotion": "慈爱", "tts_prompt": "六十多岁女性声音，语气温和，慈爱，带着满足。", "speech_rate": "Medium", "pause_after": "Short (0.26s)", "tts_tag": "[happy]", "tts_tag_score": 7, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 180.239, "end_time": 189.6267}, {"turn_id": 23, "speaker": "HM", "text": "只要你住得舒服顺心，我这钱花得就比啥都值，一点不心疼。", "emotion": "欣慰", "tts_prompt": "年轻男性声音，语气欣慰，真诚。", "speech_rate": "Medium", "pause_after": "Short (0.40s)", "tts_tag": "[happy]", "tts_tag_score": 6, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 189.8867, "end_time": 196.859}, {"turn_id": 24, "speaker": "AI", "text": "行了行了，不说那些让人掉眼泪的事儿了。下周末的暖房酒，咱们得好好捋捋菜单。", "emotion": "转移话题", "tts_prompt": "六十多岁女性声音，语气轻松，把话题拉回正事。", "speech_rate": "Medium", "pause_after": "Short (0.26s)", "tts_tag": "[neutral]", "tts_tag_score": 5, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 197.259, "end_time": 204.5396}, {"turn_id": 25, "speaker": "HM", "text": "菜单你就别费脑子了。我打算在附近那家口碑好的菜馆订一桌，到点直接送上门，省事还好吃。", "emotion": "提议", "tts_prompt": "年轻男性声音，语气坚持，想要为母亲省事。", "speech_rate": "Medium", "pause_after": "Short (0.24s)", "tts_tag": "[neutral]", "tts_tag_score": 5, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 204.7996, "end_time": 213.1791}, {"turn_id": 26, "speaker": "AI", "text": "<注释>着急</注释>那哪能行啊！暖房酒就得自己开火做饭才有家的烟火气，点外卖像什么话啊！", "emotion": "着急", "tts_prompt": "六十多岁女性声音，语气着急，语速加快，强烈反对。", "speech_rate": "Fast", "pause_after": "Short (0.29s)", "tts_tag": "[angry]", "tts_tag_score": 7, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 213.4191, "end_time": 221.8806}, {"turn_id": 27, "speaker": "HM", "text": "<注释>无奈</注释>妈，七八个人的饭菜呢，光洗菜切菜就能把你累得腰都直不起来，偶尔订一次现成的怎么了啊？", "emotion": "无奈", "tts_prompt": "年轻男性声音，语气无奈，劝说。", "speech_rate": "Medium", "pause_after": "Short (0.24s)", "tts_tag": "[sad]", "tts_tag_score": 5, "speaker_id": "role_2", "speaker_name": "张明", "role_label": "HM", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 222.1706, "end_time": 232.0152}, {"turn_id": 28, "speaker": "AI", "text": "<注释>固执</注释>那不行，这老规矩不能破。你大姨二舅他们可都盼着吃我做的拿手菜呢。", "emotion": "固执", "tts_prompt": "六十多岁女性声音，语气固执，坚持传统。", "speech_rate": "Medium", "pause_after": "Short (0.25s)", "tts_tag": "[angry]", "tts_tag_score": 5, "speaker_id": "role_1", "speaker_name": "张秀兰", "role_label": "AI", "turn_sound_requests": [], "turn_event_requests": [], "start_time": 232.2552, "end_time": 238.4519}, {"turn_id": 29, "speaker": "HM", "text": "外面大厨做的可不比咱自己做的差啊，你听我的，这次就订餐，你安安稳稳坐藤椅上陪他们唠嗑就行，行不？", "emotion": "劝说", "tts_prompt": "年轻男性声音，语气劝说，试图说服母亲。", "speech_rate": "Medium", "pause_after": "Short (0.25s)", "tts_ta